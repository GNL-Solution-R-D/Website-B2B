# =====================================================================
#  GNL Solution — routage Apache (mod_rewrite)
#  /contact -> pages/contact.php, /cart -> pages/cart.php, etc.
# =====================================================================
Options -Indexes
DirectoryIndex router.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Dossiers et fichiers internes : jamais servis directement
  RewriteRule ^(include|lang|geoip|pages)/ - [F,L]
  RewriteRule ^(dev-router|index)\.php$ - [F,L]

  # Tout ce qui n'est pas un fichier réel (assets…) passe par le contrôleur frontal :
  # région d'après le sous-domaine, langue d'après le préfixe /fr/, /de/…
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ router.php [L,QSA]
  RewriteRule ^$ router.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType font/ttf "access plus 1 year"
</IfModule>
