# =====================================================================
#  GNL Solution — routage Apache (mod_rewrite)
#  /contact -> pages/contact.php, /cart -> pages/cart.php, etc.
# =====================================================================
#  IMPORTANT : ce fichier n'est lu que si le vhost autorise « AllowOverride All »
#  (Debian l'interdit par défaut pour /var/www). Sinon : erreur « Not Found » sur /fr/, /it/…
# =====================================================================
Options -Indexes
DirectoryIndex router.php
# Repli si mod_rewrite est absent : toute URL inexistante passe par router.php
FallbackResource /router.php

# Par défaut : un sous-domaine par région (eu./ch./ca./uk.gnl-solution.com).
# Pour tout garder sur un seul domaine (dépannage), décommentez :
# <IfModule mod_env.c>
#   SetEnv GNL_SINGLE_HOST 1
# </IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Dossiers et fichiers internes : jamais servis directement
  RewriteRule ^(include|lang|geoip|pages)/ - [F,L]
  RewriteRule ^(dev-router|index)\.php$ - [F,L]

  # Tout ce qui n'est pas un fichier réel (assets…) passe par le contrôleur frontal :
  # région d'après le sous-domaine, langue d'après le préfixe /fr/, /de/…
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ router.php [L,QSA]
  RewriteRule ^$ router.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Cache navigateur des ressources statiques (GreenIT RWEB_0075).
# CSS/JS sont appelés avec ?v=<date de modification> : cache d'un an sans risque.
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2?|ttf|otf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(svg|png|jpe?g|webp|avif|gif|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
</IfModule>
